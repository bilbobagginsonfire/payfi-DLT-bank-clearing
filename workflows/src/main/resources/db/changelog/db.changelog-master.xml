<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="001-create-payment-message-metadata" author="payfi">
        <createTable tableName="payment_message_metadata">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="original_message_id" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="message_creation_time" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="number_of_transactions" type="INT"><constraints nullable="false"/></column>
            <column name="message_digest" type="VARCHAR(64)"><constraints nullable="false"/></column>
            <column name="received_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="metadata_linked_states">
            <column name="metadata_id" type="UUID"><constraints nullable="false" foreignKeyName="fk_linked_states_metadata" references="payment_message_metadata(id)"/></column>
            <column name="state_id" type="UUID"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="payment_message_metadata" indexName="idx_metadata_msg_id">
            <column name="original_message_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-create-idempotency-keys" author="payfi">
        <createTable tableName="idempotency_keys">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="message_id" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="instruction_id" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="response_payload" type="TEXT"><constraints nullable="false"/></column>
            <column name="state_id" type="UUID"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="idempotency_keys" columnNames="message_id, instruction_id" constraintName="uq_idempotency_msg_instr"/>
        <createIndex tableName="idempotency_keys" indexName="idx_idempotency_composite">
            <column name="message_id"/><column name="instruction_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-create-fee-accruals" author="payfi">
        <createTable tableName="fee_accruals">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="state_id" type="UUID"><constraints nullable="false"/></column>
            <column name="creditor_bank_branch_code" type="VARCHAR(6)"><constraints nullable="false"/></column>
            <column name="fee_amount" type="DECIMAL(10,2)"><constraints nullable="false"/></column>
            <column name="tax_amount" type="DECIMAL(10,2)"><constraints nullable="false"/></column>
            <column name="total_amount" type="DECIMAL(10,2)"><constraints nullable="false"/></column>
            <column name="transaction_amount" type="DECIMAL(19,2)"><constraints nullable="false"/></column>
            <column name="accrual_date" type="DATE"><constraints nullable="false"/></column>
            <column name="invoiced" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="invoice_reference" type="VARCHAR(255)"/>
            <column name="reversed" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="reversal_note" type="VARCHAR(500)"/>
        </createTable>
        <createIndex tableName="fee_accruals" indexName="idx_fee_accruals_branch"><column name="creditor_bank_branch_code"/></createIndex>
        <createIndex tableName="fee_accruals" indexName="idx_fee_accruals_date"><column name="accrual_date"/></createIndex>
        <createIndex tableName="fee_accruals" indexName="idx_fee_accruals_state"><column name="state_id"/></createIndex>
    </changeSet>

    <changeSet id="004-create-fee-rules" author="payfi">
        <createTable tableName="fee_rules">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="threshold_amount" type="DECIMAL(19,2)"><constraints nullable="false"/></column>
            <column name="fee_amount" type="DECIMAL(10,2)"><constraints nullable="false"/></column>
            <column name="currency" type="VARCHAR(3)" defaultValue="ZAR"><constraints nullable="false"/></column>
            <column name="fee_payer" type="VARCHAR(50)" defaultValue="CREDITOR_BANK"><constraints nullable="false"/></column>
            <column name="effective_from" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <!-- Portable default: use fixed UUID instead of RANDOM_UUID() -->
        <insert tableName="fee_rules">
            <column name="id" value="00000000-0000-0000-0000-000000000001"/>
            <column name="threshold_amount" valueNumeric="3000.00"/>
            <column name="fee_amount" valueNumeric="0.20"/>
            <column name="currency" value="ZAR"/>
            <column name="fee_payer" value="CREDITOR_BANK"/>
            <column name="effective_from" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>

    <changeSet id="005-create-settlement-reports" author="payfi">
        <createTable tableName="settlement_reports">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="bank_branch_code" type="VARCHAR(6)"><constraints nullable="false"/></column>
            <column name="window_start" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="window_end" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="net_amount" type="DECIMAL(19,2)"><constraints nullable="false"/></column>
            <column name="gross_payable" type="DECIMAL(19,2)"><constraints nullable="false"/></column>
            <column name="gross_receivable" type="DECIMAL(19,2)"><constraints nullable="false"/></column>
            <column name="transaction_count" type="INT"><constraints nullable="false"/></column>
            <column name="generated_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="settlement_reports" indexName="idx_settlement_branch"><column name="bank_branch_code"/></createIndex>
    </changeSet>

    <changeSet id="006-create-participant-status" author="payfi">
        <createTable tableName="participant_status">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="branch_code" type="VARCHAR(6)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="effective_from" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="reason" type="VARCHAR(500)"><constraints nullable="false"/></column>
            <column name="initiated_by" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="reinstated_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="participant_status" indexName="idx_participant_branch"><column name="branch_code"/></createIndex>
    </changeSet>

</databaseChangeLog>

